# Copy to .env.local and fill in. Placeholder values only — never commit real secrets.
# Local PGlite needs none of these; run `npm run db:setup` to generate tokens.

# Secret author token that gates /loft/<token> (set by `npm run db:setup`)
AUTHOR_TOKEN=replace-with-a-long-random-token

# Postgres connection string for production (e.g. Neon); omit for local PGlite
DATABASE_URL=postgres://user:password@host:5432/dbname

# Resend API key for the daily digest email
RESEND_API_KEY=replace-with-your-resend-api-key

# Verified Resend sender, e.g. "Pigeon Post <onboarding@resend.dev>"
EMAIL_FROM=Pigeon Post <onboarding@resend.dev>

# Where the digest email is delivered
RECIPIENT_EMAIL=recipient@example.com

# Secret recipient mailbox link (set by `npm run db:setup`); falls back to APP_BASE_URL
RECIPIENT_URL=http://localhost:3100/m/replace-with-recipient-token

# Public base URL of the deployed app
APP_BASE_URL=http://localhost:3100

# If set, /api/cron/digest requires Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret

# Display name and IANA timezone used when creating the recipient (db:setup)
RECIPIENT_NAME=Someone
RECIPIENT_TZ=UTC
